{
  "name": "jachaikori",
  "version": "0.1.0",
  "private": true,
  "description": "Jachaikori (যাচাই করি) monorepo — Bangla viral photo-card fact-checking and news verification pipeline",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "api": "bun --filter @jachaikori/api dev",
    "web": "bun --filter @jachaikori/web dev",
    "crawler": "bun --filter @jachaikori/crawler run",
    "backfill": "bun --filter @jachaikori/backfill start",
    "test": "bun test",
    "typecheck": "tsc --noEmit --composite false"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
