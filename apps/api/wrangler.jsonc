{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jachaikori-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jachaikori-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "jachaikori-chunks"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
